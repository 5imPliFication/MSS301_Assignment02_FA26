# Meridian local configuration. Keep values unquoted; do not use shell expansion.
# .env is private and ignored by Git. Copy .env.example when setting up elsewhere.

# SQL Server 2019 (major version 15); SQL authentication
DB_HOST=localhost
DB_PORT=1433
DB_USERNAME=sa
DB_PASSWORD=sa
DB_ACCOUNT_NAME=DBAccount
DB_BRAND_NAME=DBBrand
DB_WATCH_NAME=DBWatch
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true

# Spring service ports and HTTP endpoints (keep URLs aligned with ports)
GATEWAY_PORT=8080
ACCOUNT_PORT=8081
BRAND_PORT=8082
WATCH_PORT=8083
GATEWAY_URL=http://localhost:8080
ACCOUNT_SERVICE_URL=http://localhost:8081
BRAND_SERVICE_URL=http://localhost:8082
WATCH_SERVICE_URL=http://localhost:8083

# Shared by AccountService and Gateway; expiration is milliseconds (24 hours)
JWT_SECRET=replace-this-with-a-random-secret-of-at-least-32-bytes-before-deployment
JWT_EXPIRATION=86400000
# Shared by all four services; never expose in a VITE_ variable
SERVICE_INTERNAL_KEY=replace-this-with-a-random-internal-service-key

# Database logging and code-first schema management
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
BRAND_CONNECT_TIMEOUT=3000
BRAND_READ_TIMEOUT=5000

# Frontend development/preview servers
FRONTEND_PORT=5173
FRONTEND_PREVIEW_PORT=4173
# Empty uses the same-origin /api proxy. Only VITE_ values reach browser code.
VITE_API_URL=

# Local app login (seeded, not configured by environment): adminsys / @1
# SQL Server must already accept the database credentials above.
# Optional Java installation path (use forward slashes, no quotes):
# JAVA_HOME=C:/ProgramFiles/Java/jdk-21
